# Server
NODE_ENV=development
PORT=3001
TRUST_PROXY=false
JWT_SECRET=
DATABASE_PATH=data/codecraft.sqlite
UPLOAD_DIR=uploads

# Initial administrator (created automatically on first server start)
ADMIN_NAME=CodeCraft Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP settings. Without SMTP, notifications are saved in SQLite but not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
